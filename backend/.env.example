# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/comoro_move?schema=public"

# Auth
JWT_SECRET="change_this_super_secret_key"
JWT_EXPIRES_IN="30d"

# Clé secrète à usage unique servant à créer le tout premier compte
# super-admin ("Agence Raha") via POST /api/auth/super-admin/bootstrap.
# Choisissez une valeur longue et aléatoire ; cette route se désactive
# automatiquement dès qu'un compte super-admin existe.
RAHA_OPS_KEY="change_this_ops_key"

# Serveur
PORT=4000
CLIENT_URL="http://localhost:3000"

# Paiement Mobile Money (agrégateur local, ex: HolluPay / MHC / Telma)
MOBILE_MONEY_API_URL="https://api.votre-agregateur-comores.com"
MOBILE_MONEY_API_KEY="xxx"
MOBILE_MONEY_MERCHANT_ID="xxx"

# Google Maps (directions, geocoding)
# SMS (optionnel — sans ces variables, les SMS sont simplement journalisés, pas envoyés)
SMS_API_URL="https://api.votre-agregateur-sms.com"
SMS_API_KEY="xxx"

GOOGLE_MAPS_API_KEY="xxx"
