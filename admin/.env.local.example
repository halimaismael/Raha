NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Clé secrète utilisée par les routes serveur admin (app/api/independent-drivers)
# pour valider/refuser les chauffeurs indépendants auprès du backend. Doit être
# EXACTEMENT la même valeur que RAHA_OPS_KEY sur le backend (Railway).
# Ne jamais préfixer par NEXT_PUBLIC_ (elle resterait alors côté serveur uniquement,
# c'est voulu : elle ne doit jamais apparaître dans le code envoyé au navigateur).
RAHA_OPS_KEY=change_this_ops_key
